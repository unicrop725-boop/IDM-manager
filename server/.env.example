# Copy this file to server/.env and fill it in. server/.env is git-ignored. Never commit real keys.
GOOGLE_CLIENT_ID=
ALLOWED_ORIGINS=https://boltgrab.online,https://www.boltgrab.online
SITE_URL=https://boltgrab.online
TRUST_PROXY=1

# Admin panel: emails allowed into /admin/ (they must also have signed in with Google once)
ADMIN_EMAILS=you@example.com
# Blog publishing from the admin panel: commits Markdown to this repository (Cloudflare Pages then rebuilds the site)
# Token: GitHub > Settings > Developer settings > Fine-grained tokens > this repo only > Contents: Read and write
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
GITHUB_SITE_DIR=website

# Dodo Payments
DODO_ENV=test
DODO_API_KEY=
DODO_PRODUCT_ID=
DODO_WEBHOOK_SECRET=
