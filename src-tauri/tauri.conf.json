{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowGet",
  "version": "0.1.0",
  "identifier": "com.flowget.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowGet",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 460,
        "decorations": false,
        "visible": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["flowget"],
        "name": "FlowGet Download Package",
        "description": "FlowGet Download Package",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": ["en-US"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3OEU5OTNFMEYzNDlGMDkKUldSS0Q1M2hLMDdJTkVrcnh2NmFZZWc4Y2JvR0QzR2tZcXhBQXpXamFqa1p6MWZkVW9wWGlmUW4K",
      "endpoints": [
        "https://releases.flowget.net/updates/{{target}}/{{current_version}}.json"
      ]
    }
  }
}
