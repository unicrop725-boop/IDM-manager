---
interface Props {
  items: { name: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav class="crumbs wrap" aria-label="Breadcrumb">
  {items.map((it, i) => (
    <>
      {i > 0 && <span aria-hidden="true">/</span>}
      {it.href ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
    </>
  ))}
</nav>
