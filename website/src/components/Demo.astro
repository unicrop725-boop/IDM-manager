---
// The real BoltGrab window, embedded. /app-demo/ is the app's own UI built in demo mode (`npm run build:demo` in the
// app repo): a simulated backend moves the downloads along, so nothing is fetched and everything is clickable.
---
<div class="demo-wrap" id="demo">
  <div class="appframe" id="appframe">
    <iframe id="appdemo" src="/app-demo/index.html" title="BoltGrab running live. Click inside to try it." loading="eager" allow="clipboard-write"></iframe>
  </div>
  <p class="demo-caption">
    <span><i class="dot"></i><b>The real app</b> — click inside</span>
    <span id="c-active">– downloads active</span>
    <span id="c-speed">– total</span>
    <span id="c-done">– finished</span>
    <span><button type="button" id="demo-reset">Reset demo</button></span>
    <span><a href="/app-demo/index.html" target="_blank" rel="noopener">Open full screen ↗</a></span>
  </p>
</div>
<script is:inline src="/js/demo-embed.js" defer></script>
