---
import { SITE } from "../config";
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="brand" href="/"><img src="/img/icon-128.png" alt="" width="26" height="26" loading="lazy" />{SITE.name}</a>
        <p class="foot-about">A fast, patient download manager for Windows. It splits files across many connections and carries on after any interruption.</p>
      </div>
      <div>
        <h4>Product</h4>
        <ul>
          <li><a href="/features/">Features</a></li>
          <li><a href="/#demo">Live demo</a></li>
          <li><a href="/#pricing">Pricing</a></li>
          <li><a href="/download/">Download</a></li>
        </ul>
      </div>
      <div>
        <h4>Learn</h4>
        <ul>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/switch-from-idm/">Switch from IDM</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/signin/">Sign in</a></li>
          <li><a href={`mailto:${SITE.supportEmail}`}>Contact</a></li>
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {year} {SITE.name}. Version {SITE.version}</span>
      <span>Windows 10 &amp; 11 · No ads · No tracking</span>
    </div>
  </div>
</footer>
