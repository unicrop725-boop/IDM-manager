---
import { SITE } from "../config";
interface Props {
  current?: string;
}
const { current = "" } = Astro.props;
const link = (href: string, label: string, key: string) => ({ href, label, active: current === key });
const items = [
  link("/features/", "Features", "features"),
  link("/#pricing", "Pricing", ""),
  link("/blog/", "Blog", "blog"),
  link("/download/", "Download", "download"),
  link("/signin/", "Sign in", "signin"),
];
---
<header class="nav">
  <div class="nav-in">
    <a class="brand" href="/"><img src="/img/icon-128.png" alt="" width="26" height="26" />{SITE.name}</a>
    <nav class="nav-links" id="nav-links" aria-label="Main">
      {items.map((i) => <a href={i.href} aria-current={i.active ? "page" : undefined}>{i.label}</a>)}
    </nav>
    <a class="btn btn-primary btn-sm nav-cta" href="/#pricing">Get FlowGet</a>
    <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="nav-links">Menu</button>
  </div>
</header>
