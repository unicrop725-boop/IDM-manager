---
import type { Post } from "../lib/blog";
import { formatDate, readingMinutes } from "../lib/blog";
import { SITE } from "../config";
interface Props {
  post: Post;
}
const { post } = Astro.props;
const href = `/blog/${post.id}/`;
const author = post.data.author ?? SITE.defaultAuthor;
---
<article class="bcard">
  <a href={href} class="bcard-img" tabindex="-1" aria-hidden="true">
    {post.data.cover ? <img src={post.data.cover} alt="" loading="lazy" width="1200" height="630" /> : <span>{post.data.title}</span>}
  </a>
  <div class="bcard-body">
    <div class="bcard-meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <i aria-hidden="true">•</i>
      <span>{readingMinutes(post.body)} min read</span>
    </div>
    <h3><a href={href}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <div class="bcard-author">
      <img src="/img/icon-128.png" alt="" width="30" height="30" loading="lazy" />
      <span><b>{author}</b> · {SITE.defaultAuthorRole}</span>
    </div>
  </div>
</article>
