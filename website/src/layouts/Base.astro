---
// One build stamp per build: a changed stamp makes browsers fetch the new stylesheet.
const cssHref = "/css/global.css?v=" + Date.now();
import { SITE } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  /** The page's own title. The site name is added after it unless `fullTitle` is set. */
  title: string;
  fullTitle?: boolean;
  description: string;
  /** Picture for shared links (path in /public or a full address). */
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  /** Structured data objects (schema.org), written as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
  /** Mark the current section in the menu. */
  current?: "features" | "pricing" | "blog" | "download" | "home" | "";
  /** No site header, footer or menu script (sign-in and account pages). */
  bare?: boolean;
  bodyClass?: string;
}

const {
  title,
  fullTitle = false,
  description,
  image = SITE.ogImage,
  imageAlt = `${SITE.name} download manager`,
  type = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  jsonLd = [],
  current = "",
  bare = false,
  bodyClass = "",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
// Search results show about 60 characters: add the site name only when it still fits.
const pageTitle = fullTitle || title.length > 48 ? title : `${title} | ${SITE.name}`;
---
<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta name="theme-color" content="#f4f4f2" />

    <link rel="icon" type="image/x-icon" href={"/favicon.ico?v=" + Date.now()} />
    <link rel="shortcut icon" href={"/favicon.ico?v=" + Date.now()} />
    <link rel="icon" type="image/png" sizes="32x32" href={"/img/favicon-32.png?v=" + Date.now()} />
    <link rel="apple-touch-icon" sizes="180x180" href={"/img/icon-256.png?v=" + Date.now()} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/rss.xml" />
    <link rel="preload" href="/fonts/outfit.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={cssHref} />
    <slot name="head" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === "article" && tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {/* "<" and friends as \uXXXX: JSON.stringify alone leaves "</script>" in a title, which would close this tag early. Parsers read the escapes as the same text. */}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, "\\u003c").replace(/>/g, "\\u003e").replace(/&/g, "\\u0026").replace(/\u2028/g, "\\u2028").replace(/\u2029/g, "\\u2029")} />)}
  </head>
  <body class={bodyClass || undefined}>
    <a class="skip" href="#main">Skip to content</a>
    {!bare && <Header current={current} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && <script is:inline src={"/js/menu.js?v=" + Date.now()}></script>}
    {!bare && <script is:inline src={"/js/analytics.js?v=" + Date.now()} defer></script>}
  </body>
</html>
