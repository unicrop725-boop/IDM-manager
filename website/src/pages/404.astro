---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page does not exist or has moved." noindex>
  <div class="wrap" style="min-height:60vh;display:grid;place-items:center;text-align:center">
    <div>
      <h1 style="font-size:72px" class="grad-text">404</h1>
      <p style="color:var(--muted);margin:10px 0 28px;font-size:19px">This page does not exist, or it has moved.</p>
      <a class="btn btn-primary" href="/">Back to BoltGrab</a>
      <a class="btn btn-ghost" href="/blog/" style="margin-left:10px">Read the blog</a>
    </div>
  </div>
</Base>
