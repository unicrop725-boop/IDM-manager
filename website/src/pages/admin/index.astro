---
import Base from "../../layouts/Base.astro";
import { SITE } from "../../config";
---
<Base title="Admin" description="BoltGrab admin." noindex bare bodyClass="adm">
  <link slot="head" rel="stylesheet" href="/css/vendor/toastui-editor.css" />
  <link slot="head" rel="stylesheet" href={"/css/admin.css?v=" + Date.now()} />

  <div id="admin" class="app" data-api={SITE.apiUrl}>
    <aside class="side">
      <a class="brand" href="/"><img src="/img/icon-128.png" alt="" width="34" height="34" /><span><b>{SITE.name}</b><small>Admin</small></span></a>

      <nav class="snav" id="tabs" aria-label="Sections" hidden>
        <button type="button" data-tab="overview" class="on">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="8" rx="2"/><rect x="13.5" y="3.5" width="7" height="5" rx="2"/><rect x="13.5" y="11.5" width="7" height="9" rx="2"/><rect x="3.5" y="14.5" width="7" height="6" rx="2"/></svg>
          <span>Overview</span>
        </button>
        <button type="button" data-tab="users">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8.5" r="3.5"/><path d="M2.8 20c.7-3.6 3.2-5.4 6.2-5.4s5.5 1.8 6.2 5.4"/><path d="M16 5.4a3.5 3.5 0 0 1 0 6.2M18.4 14.9c1.7.8 2.8 2.4 3.2 5.1"/></svg>
          <span>Users</span>
        </button>
        <button type="button" data-tab="purchases">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="M3 10h18M7 15h3"/></svg>
          <span>Purchases</span>
        </button>
        <button type="button" data-tab="reviews">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.6l2.5 5.3 5.8.8-4.2 4.1 1 5.8L12 16.9l-5.1 2.7 1-5.8-4.2-4.1 5.8-.8z"/></svg>
          <span>Reviews</span><em class="badge" id="rv-badge" hidden></em>
        </button>
        <button type="button" data-tab="blog">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h10.5L19 8v11.5H5z"/><path d="M15 4.5V8h4M8.5 12h7M8.5 15.5h7"/></svg>
          <span>Blog</span>
        </button>
      </nav>

      <div class="side-foot" id="who" hidden>
        <div class="me"><span class="av" id="who-av"></span><span class="me-t"><b id="who-name"></b><small id="who-email"></small></span></div>
        <a href="/" class="lnk">View website</a>
        <a href="/account/" class="lnk">My account</a>
        <button type="button" id="signout" class="lnk">Sign out</button>
      </div>
    </aside>

    <div class="main">
      <header class="head">
        <div class="head-t"><h1 id="page-title">Overview</h1><p id="page-sub"></p></div>
        <div class="actions" id="actions" hidden>
          <div class="seg" id="range" role="group" aria-label="Period">
            <button type="button" data-days="7">7 days</button>
            <button type="button" data-days="30" class="on">30 days</button>
            <button type="button" data-days="90">90 days</button>
          </div>
          <button type="button" class="btn ghost" id="refresh">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v4.5h-4.5"/></svg>Refresh
          </button>
          <button type="button" class="btn soft" id="demo" hidden>Load demo data</button>
        </div>
      </header>

      <main class="content">
        <p class="msg" id="gate">Checking your access…</p>

        <!-- Overview -->
        <section id="tab-overview" class="tab" hidden>
          <div class="kpis" id="kpis"></div>

          <div class="grid g-main">
            <div class="panel">
              <div class="ph"><div><h2>Revenue</h2><p id="rev-sub"></p></div></div>
              <div id="chart-revenue" class="chart tall"></div>
            </div>
            <div class="panel">
              <div class="ph"><div><h2>Customer funnel</h2><p>From sign-up to purchase</p></div></div>
              <div id="funnel"></div>
              <div class="ph sp"><div><h2>Licenses</h2><p id="lic-sub"></p></div></div>
              <div id="lic-status"></div>
            </div>
          </div>

          <div class="grid g-two">
            <div class="panel"><div class="ph"><div><h2>New users</h2><p id="users-sub"></p></div></div><div id="chart-users" class="chart"></div></div>
            <div class="panel"><div class="ph"><div><h2>Purchases</h2><p id="sales-sub"></p></div></div><div id="chart-sales" class="chart"></div></div>
          </div>

          <div class="panel">
            <div class="ph"><div><h2>Recent activity</h2><p>Latest sign-ups and purchases</p></div></div>
            <div id="activity" class="feed"></div>
          </div>
        </section>

        <!-- Users -->
        <section id="tab-users" class="tab" hidden>
          <div class="bar">
            <div class="search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg><input id="u-q" type="search" placeholder="Search name, email or phone" aria-label="Search users" /></div>
            <span class="count" id="u-count"></span>
            <button type="button" class="btn ghost" id="u-csv">Export CSV</button>
          </div>
          <div class="tablewrap"><table id="u-table"><thead><tr><th>User</th><th>Phone</th><th>Joined</th><th>Sign-in</th><th>Licenses</th></tr></thead><tbody></tbody></table></div>
          <div class="pager"><button type="button" class="btn ghost" id="u-prev">← Newer</button><span id="u-page"></span><button type="button" class="btn ghost" id="u-next">Older →</button></div>
        </section>

        <!-- Purchases -->
        <section id="tab-purchases" class="tab" hidden>
          <div class="bar">
            <span class="count" id="p-count"></span>
            <button type="button" class="btn ghost" id="p-csv">Export CSV</button>
          </div>
          <div class="tablewrap"><table id="p-table"><thead><tr><th>Date</th><th>Customer</th><th>Amount</th><th>License</th><th>PCs</th><th>Status</th><th></th></tr></thead><tbody></tbody></table></div>
          <h2 class="sub-h">Checkouts started, not paid yet</h2>
          <div class="tablewrap"><table id="p-pending"><thead><tr><th>Started</th><th>Email</th><th>Name</th></tr></thead><tbody></tbody></table></div>
        </section>

        <!-- Reviews -->
        <section id="tab-reviews" class="tab" hidden>
          <div class="bar">
            <span class="count" id="r-count"></span>
            <div class="seg" id="r-filter" role="group" aria-label="Show">
              <button type="button" data-f="pending" class="on">Waiting</button>
              <button type="button" data-f="approved">Published</button>
              <button type="button" data-f="all">All</button>
            </div>
          </div>
          <div id="r-list" class="rlist"></div>
        </section>

        <!-- Blog -->
        <section id="tab-blog" class="tab" hidden>
          <p class="note" id="b-mode"></p>
          <div class="blog-grid">
            <form id="b-form" class="panel" novalidate>
              <div class="ph">
                <div><h2 id="b-heading">Write a post</h2><p id="b-editing" hidden></p></div>
                <button type="button" class="btn ghost sm" id="b-new" hidden>+ New post</button>
              </div>
              <div class="restore" id="b-restore" hidden>
                <span>You have an unsaved draft from earlier.</span>
                <button type="button" class="btn ghost sm" id="b-restore-yes">Restore it</button>
                <button type="button" class="btn ghost sm" id="b-restore-no">Discard</button>
              </div>
              <label for="b-title">Title <small id="b-title-n"></small></label>
              <input id="b-title" type="text" maxlength="110" placeholder="How to speed up large downloads on Windows" />

              <label for="b-slug">Address <small>/blog/<span id="b-slug-show">…</span>/</small></label>
              <input id="b-slug" type="text" maxlength="80" placeholder="auto from the title" />

              <label for="b-desc">Short description <small id="b-desc-n"></small></label>
              <textarea id="b-desc" rows="3" maxlength="200" placeholder="Shown in Google results and on the blog cards (50 to 200 characters)."></textarea>

              <div class="row">
                <div><label for="b-tags">Tags</label><input id="b-tags" type="text" placeholder="speed, windows" /></div>
                <div><label for="b-date">Publish date <small>(empty = now)</small></label><input id="b-date" type="datetime-local" /></div>
              </div>

              <div class="row">
                <div><label for="b-author">Author <small>(optional)</small></label><input id="b-author" type="text" maxlength="60" placeholder="BoltGrab Team" /></div>
                <div><label for="b-img">Cover image <small>PNG, JPG or WebP, up to 2.5 MB</small></label><input id="b-img" type="file" accept="image/png,image/jpeg,image/webp" /></div>
              </div>
              <div id="b-img-prev" class="imgprev" hidden><img alt="" /><button type="button" id="b-img-clear" class="btn ghost sm">Remove</button></div>
              <label for="b-alt">Cover image description <small>(for screen readers and SEO)</small></label>
              <input id="b-alt" type="text" maxlength="160" />

              <label for="b-body">Article <small>Use the toolbar, or switch to Markdown at the bottom. Drag or paste pictures into the text.</small></label>
              <div id="b-editor"></div>
              <textarea id="b-body" rows="18" class="mono" placeholder="Write the article here…"></textarea>
              <p class="stats" id="b-stats"></p>

              <fieldset>
                <legend>Questions and answers at the end <small>(optional, also sent to Google as FAQ)</small></legend>
                <div id="b-faq"></div>
                <button type="button" class="btn ghost sm" id="b-faq-add">+ Add a question</button>
              </fieldset>

              <div class="checks">
                <label class="check"><input id="b-featured" type="checkbox" /> Show first on the blog page</label>
                <label class="check"><input id="b-draft" type="checkbox" /> Save as draft (not shown on the site)</label>
                <label class="check" id="b-over-row" hidden><input id="b-over" type="checkbox" /> Replace the existing post with this address</label>
              </div>

              <p class="err" id="b-err" role="alert"></p>
              <p class="ok" id="b-ok" role="status"></p>
              <div class="actions-row">
                <button type="submit" class="btn primary" id="b-go">Publish post</button>
                <span class="saved" id="b-saved"></span>
              </div>
            </form>

            <aside class="panel">
              <div class="ph"><div><h2>Posts</h2></div></div>
              <div id="b-list"><p class="muted">Loading…</p></div>
            </aside>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script is:inline src="/js/vendor/toastui-editor.js" defer></script>
  <script is:inline src={"/js/admin.js?v=" + Date.now()} defer></script>
</Base>
