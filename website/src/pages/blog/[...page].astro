---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { SITE } from "../../config";
import { MIN_POSTS_FOR_TAG_PAGE, allTags, getPosts } from "../../lib/blog";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: 9 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const posts = await getPosts();
const tags = allTags(posts).filter((t) => t.count >= MIN_POSTS_FOR_TAG_PAGE);
const site = Astro.site!.href.replace(/\/$/, "");
const first = page.currentPage === 1;

const title = first ? "Blog: guides for faster, safer downloads" : `Blog, page ${page.currentPage}`;
const description = first
  ? "Practical guides on download speed, resuming broken downloads, video streams, bandwidth control and file safety on Windows, from the FlowGet team."
  : `Articles about downloads on Windows, page ${page.currentPage}.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: `${SITE.name} blog`,
    url: site + "/blog/",
    description,
    blogPost: page.data.map((p) => ({
      "@type": "BlogPosting",
      headline: p.data.title,
      url: `${site}/blog/${p.id}/`,
      datePublished: p.data.pubDate.toISOString(),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site + "/" },
      { "@type": "ListItem", position: 2, name: "Blog", item: site + "/blog/" },
    ],
  },
];
---
<Base title={title} description={description} current="blog" jsonLd={jsonLd} bodyClass="blog">
  <section class="blog-hero">
    <div class="wrap">
      <h1>{first ? "Blog & Guides" : `Blog, page ${page.currentPage}`}</h1>
      <p>Practical guides on faster downloads, resuming interrupted ones, video streams, bandwidth control and keeping files safe.</p>
      {tags.length > 0 && (
        <nav class="blog-tags" aria-label="Topics">
          {tags.map((t) => <a href={`/blog/tag/${t.slug}/`}>{t.tag}</a>)}
        </nav>
      )}
    </div>
  </section>

  <section class="blog-latest">
    <div class="wrap">
      <h2>Latest Posts</h2>
      {posts.length === 0 && <p class="fine">The first articles are on their way.</p>}
      <div class="bgrid">
        {page.data.map((p) => <PostCard post={p} />)}
      </div>

      {(page.url.prev || page.url.next) && (
        <nav class="pager" aria-label="Pagination">
          <a class="btn btn-ghost" href={page.url.prev || "#"} aria-disabled={page.url.prev ? undefined : "true"} rel="prev">← Newer</a>
          <span class="fine">Page {page.currentPage} of {page.lastPage}</span>
          <a class="btn btn-ghost" href={page.url.next || "#"} aria-disabled={page.url.next ? undefined : "true"} rel="next">Older →</a>
        </nav>
      )}
    </div>
  </section>
</Base>
