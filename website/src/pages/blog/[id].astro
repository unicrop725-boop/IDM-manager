---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import TagList from "../../components/TagList.astro";
import { SITE, buyHref } from "../../config";
import { formatDate, getPosts, readingMinutes, relatedPosts } from "../../lib/blog";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post, posts } }));
}) satisfies GetStaticPaths;

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const site = Astro.site!.href.replace(/\/$/, "");
const url = `${site}/blog/${post.id}/`;
const { title, description, pubDate, updatedDate, tags, faq } = post.data;
const author = post.data.author ?? SITE.defaultAuthor;
const cover = post.data.cover ?? SITE.ogImage;
const minutes = readingMinutes(post.body);
const toc = headings.filter((h) => h.depth === 2);
const related = relatedPosts(post, posts, 3);

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    image: [new URL(cover, site).href],
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: { "@type": "Organization", name: author, url: site + "/" },
    publisher: { "@type": "Organization", name: SITE.name, logo: { "@type": "ImageObject", url: site + "/img/icon-256.png" } },
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    keywords: tags.join(", "),
    wordCount: (post.body ?? "").split(/\s+/).filter(Boolean).length,
    inLanguage: SITE.language,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site + "/" },
      { "@type": "ListItem", position: 2, name: "Blog", item: site + "/blog/" },
      { "@type": "ListItem", position: 3, name: title, item: url },
    ],
  },
];
if (faq.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  });
}
---
<Base
  title={title}
  description={description}
  type="article"
  image={cover}
  imageAlt={post.data.coverAlt ?? title}
  publishedTime={pubDate}
  modifiedTime={updatedDate ?? pubDate}
  tags={tags}
  current="blog"
  jsonLd={jsonLd}
  bodyClass="blog"
>
  <div class="wrap post-wrap">
    <header class="post-head">
      <div class="post-top">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <i aria-hidden="true">•</i>
        <span>{minutes} min read</span>
      </div>
      <h1>{title}</h1>
    </header>

    <figure class="post-hero">
      <img src={cover} alt={post.data.coverAlt ?? title} width="1200" height="630" fetchpriority="high" />
    </figure>

    <div class="post-cols">
      <aside class="post-side">
        <div class="post-author">
          <img src="/img/icon-128.png" alt="" width="44" height="44" />
          <div><b>{author}</b><span>{SITE.defaultAuthorRole}</span></div>
        </div>
        <div class="post-share">
          <b>Share this post</b>
          <div class="share-row" data-share-url={url}>
            <button type="button" data-copy aria-label="Copy link" title="Copy link">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"/></svg>
            </button>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" title="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path class="f" d="M4.5 3A2.5 2.5 0 1 0 4.5 8 2.5 2.5 0 0 0 4.5 3ZM2.3 9.6h4.4V22H2.3V9.6Zm7.2 0h4.2v1.7h.1c.6-1.1 2-2 4.1-2 4.4 0 5.2 2.9 5.2 6.6V22h-4.4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V22H9.5V9.6Z"/></svg>
            </a>
            <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X" title="X">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path class="f" d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.3L5.3 21H2.2l7.3-8.3L2 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z"/></svg>
            </a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" title="Facebook">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path class="f" d="M13.5 22v-8.2h2.8l.4-3.3h-3.2V8.4c0-.9.3-1.6 1.6-1.6h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.5H7.4v3.3h2.8V22h3.3Z"/></svg>
            </a>
            <span class="copied" role="status" hidden>Link copied</span>
          </div>
        </div>
        {tags.length > 0 && <div class="post-tags"><TagList tags={tags} /></div>}
        {toc.length >= 3 && (
          <nav class="post-toc" aria-label="In this article">
            <b>In this article</b>
            <ol>
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </nav>
        )}
      </aside>

      <article class="post-main">
        <p class="post-lede">{description}</p>
        <div class="article-body">
          <Content />
        </div>

        {faq.length > 0 && (
          <section class="faq" style="margin-top:48px;max-width:none" aria-labelledby="faq-h">
            <h2 id="faq-h" style="font-size:26px;margin-bottom:6px">Frequently asked questions</h2>
            {faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}

        <aside class="cta-box">
          <h2>Downloads that don't give up</h2>
          <p>FlowGet resumes after any interruption, limits speed by schedule and warns about risky files. ${SITE.priceUsd} once, no subscription.</p>
          <a class="btn btn-primary" href={buyHref()}>Get FlowGet Pro</a>
          <p style="margin:14px 0 0;font-size:15px"><a href="/features/" style="color:var(--lime-ink)">See every feature</a></p>
        </aside>
      </article>
    </div>

    {related.length > 0 && (
      <section class="related" aria-labelledby="rel-h">
        <h2 id="rel-h">Keep reading</h2>
        <div class="bgrid">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </section>
    )}
  </div>
  <script is:inline src="/js/share.js" defer></script>
</Base>
