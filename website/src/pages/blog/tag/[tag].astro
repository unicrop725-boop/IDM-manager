---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import PostCard from "../../../components/PostCard.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { MIN_POSTS_FOR_TAG_PAGE, allTags, getPosts, tagSlug } from "../../../lib/blog";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return allTags(posts)
    .filter((t) => t.count >= MIN_POSTS_FOR_TAG_PAGE)
    .map((t) => ({
      params: { tag: t.slug },
      props: { tag: t.tag, posts: posts.filter((p) => p.data.tags.some((x) => tagSlug(x) === t.slug)) },
    }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
const site = Astro.site!.href.replace(/\/$/, "");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site + "/" },
      { "@type": "ListItem", position: 2, name: "Blog", item: site + "/blog/" },
      { "@type": "ListItem", position: 3, name: tag, item: `${site}/blog/tag/${tagSlug(tag)}/` },
    ],
  },
];
---
<Base
  title={`${tag}: articles and guides`}
  description={`FlowGet articles about ${tag}: ${posts.length} guide${posts.length === 1 ? "" : "s"} for Windows users on speed, reliability and safety of downloads.`}
  current="blog"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ name: "Home", href: "/" }, { name: "Blog", href: "/blog/" }, { name: tag }]} />
  <div class="wrap">
    <div class="page-head" style="padding-top:24px">
      <h1>Articles about <span class="grad-text">{tag}</span></h1>
      <p>{posts.length} guide{posts.length === 1 ? "" : "s"}. <a href="/blog/" style="color:var(--sky)">All articles</a></p>
    </div>
    <div class="post-grid">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </div>
</Base>
