---
import Base from "../layouts/Base.astro";
import AuthShell from "../components/AuthShell.astro";
import { SITE } from "../config";
---
<Base title={`Get ${SITE.name} Pro`} description={`Buy ${SITE.name} Pro: one payment, lifetime license, no subscription.`} noindex bare bodyClass="authx">
  <link slot="head" rel="stylesheet" href={"/css/auth.css?v=" + Date.now()} />
  <AuthShell hint="Already bought?" linkText="My account" linkHref="/account/">
    <div id="buy" data-api={SITE.apiUrl}>
      <section id="buy-form" class="view" hidden>
        <span class="badge" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="M3 10h18M7 15h3"/></svg></span>
        <h1>Get {SITE.name} Pro</h1>
        <p class="sub">One payment of <b>${SITE.priceUsd}</b>. Lifetime license for 2 PCs, no subscription.</p>

        <form id="form-buy" novalidate>
          <label for="b-email">Email address</label>
          <input id="b-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required />
          <label for="b-name">Full name <span class="opt">(optional)</span></label>
          <input id="b-name" name="name" type="text" autocomplete="name" maxlength="80" placeholder="Your name" />

          <p class="err" id="err-buy" role="alert"></p>
          <button class="primary" type="submit" id="btn-buy">Continue to secure payment</button>
        </form>

        <ul class="perks">
          <li>License key shown right after payment and kept on your account</li>
          <li>Works offline; activate on up to 2 PCs</li>
          <li>Every feature included, free updates for version 1</li>
        </ul>
        <p class="legal">Payments are processed securely by Dodo Payments. We never see your card details.</p>
      </section>

      <section id="buy-off" class="view" hidden>
        <span class="badge" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v5M12 16v.1"/></svg></span>
        <h1>Online payment is not available yet</h1>
        <p class="sub">Please <a href={`mailto:${SITE.supportEmail}?subject=${encodeURIComponent("FlowGet Pro")}`}>email support</a> to buy FlowGet Pro.</p>
      </section>
    </div>
  </AuthShell>
  <script is:inline src="/js/buy.js" defer></script>
</Base>
