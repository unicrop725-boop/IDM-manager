---
import Base from "../layouts/Base.astro";
import { SITE } from "../config";

const site = Astro.site!.href.replace(/\/$/, "");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site + "/" },
      { "@type": "ListItem", position: 2, name: "Download", item: site + "/download/" },
    ],
  },
];

const s = 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
const winPath = "M2 2h9.4v9.4H2zM12.6 2H22v9.4h-9.4zM2 12.6h9.4V22H2zM12.6 12.6H22V22h-9.4z";
const chrome = `<path d="M12 2a10 10 0 0 0-8.66 5l4.33 7.5L12 7h8.66A10 10 0 0 0 12 2z" fill="#EA4335"/><path d="M22 12a10 10 0 0 0-1.34-5H12l-4.33 7.5 4.33 7.5h8A10 10 0 0 0 22 12z" fill="#FBBC05"/><path d="M12 22a10 10 0 0 0 8-4H12l-4.33-7.5L3.34 17A10 10 0 0 0 12 22z" fill="#34A853"/><circle cx="12" cy="12" r="4.8" fill="#fff"/><circle cx="12" cy="12" r="3.8" fill="#1A73E8"/>`;
const edge = `<path d="M22 12.2c-.3 4.2-3.4 7.6-7.6 8-5.3.5-9.8-3.4-10-8.7 0-.7.1-1.4.3-2.1.5-1.5 1.5-2.8 2.8-3.8 2.1-1.6 4.8-2.3 7.4-1.9-3.2 1.4-4.8 4.3-4.1 7.7.6 2.8 3 4.9 5.8 4.9h1.3c2.2 0 4-1.8 3.9-4 0-.4-.1-.8-.3-1.1.5 1.5.6 3.2.3 5z" fill="#0078D4"/><path d="M15.2 2.3C10.3 2 5.9 5.5 4.7 10.3c-.4 1.6-.4 3.3-.1 4.9-.9-1.9-1.1-4.1-.7-6.1C5 5.8 8.3 3.1 11.9 2.3c1.1-.3 2.2-.3 3.3 0z" fill="#00C853"/><path d="M4.6 15.2c1 4.3 4.3 7.6 8.6 8.4-3.2-.2-6.1-1.9-7.8-4.6-.8-1.1-1.2-2.5-1.3-3.9.2 0 .3.1.5.1z" fill="#0091EA"/>`;
const brave = `<path d="M12 2.2 4.2 5.7v5.2c0 4.8 3.3 9.3 7.8 10.5 4.5-1.2 7.8-5.7 7.8-10.5V5.7L12 2.2z" fill="#FB542B"/><path d="M12 5.2 6.3 7.7v3.5c0 3.9 2.6 7.5 5.7 8.5 3.1-1 5.7-4.6 5.7-8.5V7.7L12 5.2z" fill="#FF7A3D"/><path d="m9 11.2 3 2.8 3-2.8-1-2.2H10l-1 2.2z" fill="#fff"/><circle cx="10" cy="9.5" r=".7" fill="#1B1C21"/><circle cx="14" cy="9.5" r=".7" fill="#1B1C21"/><path d="m11 12.8 1 1 1-1-.5.7h-1l-.5-.7z" fill="#1B1C21"/>`;
const steps = [
  { t: "Run the installer", d: "Open the downloaded file and follow the prompts. It takes about a minute.", i: `<path d="M12 4v11" ${s}/><path d="m7 11 5 5 5-5" ${s}/><path d="M5 20h14" ${s}/>` },
  { t: "Activate your license", d: "Open BoltGrab, choose Help > Activate License and paste your key. It activates offline.", i: `<circle cx="8" cy="15" r="4" ${s}/><path d="m11 12 8-8M16 7l3 3" ${s}/>` },
  { t: "Connect the browser", d: "That first start also connects BoltGrab to the browser extension on your PC.", i: `<path d="M9 7 5 11l4 4M15 7l4 4-4 4" ${s}/><path d="m13 5-2 14" ${s}/>` },
  { t: "Download something", d: "Add the extension, click any download link in Chrome, Edge or Brave, and BoltGrab takes over.", i: `<path d="M13 2 3 14h9l-1 8 10-12h-9z" ${s}/>` },
];
const reqs = [
  { t: "Windows 10 or 11", d: "64-bit editions of Windows 10 and Windows 11.", i: `<rect x="3" y="4" width="18" height="12" rx="0" ${s}/><path d="M8 20h8M12 16v4" ${s}/>` },
  { t: "WebView2 runtime", d: "Microsoft Edge WebView2, already part of current Windows 10 and 11.", i: `<circle cx="12" cy="12" r="9" ${s}/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" ${s}/>` },
  { t: "Internet to download", d: "You need a connection to fetch files. BoltGrab itself also works offline.", i: `<path d="M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0" ${s}/><circle cx="12" cy="19" r="1" ${s}/>` },
];
---
<Base
  title={`Download ${SITE.name} for Windows 10 and 11`}
  description={`Download the ${SITE.name} installer for Windows 10 and 11, with installation steps, system requirements and the browser extension.`}
  current="download"
  jsonLd={jsonLd}
>
  <link slot="head" rel="stylesheet" href={"/css/home.css?v=" + Date.now()} />
  <link slot="head" rel="stylesheet" href={"/css/download.css?v=" + Date.now()} />

  <!-- ======================= Hero ======================= -->
  <section class="hero dl-hero">
    <div class="wrap">
      <span class="eyebrow"><i></i>Windows 10 &amp; 11 · 64-bit</span>
      <h1>Download {SITE.name} for Windows</h1>
      <p class="lead">One small installer. Activate your license key and {SITE.name} starts splitting, resuming and checking every download.</p>

      <div class="dlcard">
        <div class="dl-l">
          <video class="dl-video" autoplay muted loop playsinline preload="metadata" poster="/video/laser-poster.webp" aria-hidden="true" tabindex="-1"><source src="/video/laser.mp4" type="video/mp4" /></video>
          <div class="logos">
            <div class="winlogo" aria-hidden="true" title="Windows 10 & 11"><svg viewBox="0 0 24 24"><path d={winPath} /></svg></div>
          </div>
          <small>Version {SITE.version}</small>
          <h2>{SITE.name} for Windows</h2>
          <p>Windows 10 and 11 (64-bit){SITE.fileSize ? ` · ${SITE.fileSize}` : ""}</p>
          <a class="btn btn-win btn-lg" href={SITE.downloadUrl}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={`<path d="M12 4v11" ${s}/><path d="m7 11 5 5 5-5" ${s}/><path d="M5 20h14" ${s}/>`}></svg>
            Download for Windows
          </a>
          <span class="need">Need a license key? <a href="/#pricing">Get {SITE.name} Pro · ${SITE.priceUsd}</a></span>
        </div>

        <div class="dl-r">
          <h3>Release details</h3>
          <dl class="specs">
            <div><dt><svg viewBox="0 0 24 24" aria-hidden="true" set:html={`<path d="M20 12 12 20 4 12V4h8z" ${s}/><circle cx="8.5" cy="8.5" r="1" ${s}/>`}></svg>Version</dt><dd>{SITE.version}</dd></div>
            {SITE.fileSize && <div><dt><svg viewBox="0 0 24 24" aria-hidden="true" set:html={`<path d="M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3z" ${s}/><path d="M4 7v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7" ${s}/>`}></svg>File size</dt><dd>{SITE.fileSize}</dd></div>}
            <div><dt><svg viewBox="0 0 24 24" aria-hidden="true" set:html={`<rect x="3" y="4" width="18" height="12" ${s}/><path d="M8 20h8M12 16v4" ${s}/>`}></svg>Platform</dt><dd>Windows 10 / 11, 64-bit</dd></div>
            <div><dt><svg viewBox="0 0 24 24" aria-hidden="true" set:html={`<circle cx="8" cy="15" r="4" ${s}/><path d="m11 12 8-8M16 7l3 3" ${s}/>`}></svg>License</dt><dd>Key needed, activates offline</dd></div>
            <div><dt><svg viewBox="0 0 24 24" aria-hidden="true" set:html={`<path d="M12 3 4 6v6c0 4.5 3.2 7.8 8 9 4.8-1.2 8-4.5 8-9V6z" ${s}/><path d="m9 12 2 2 4-4" ${s}/>`}></svg>SHA-256</dt><dd class="hash">{SITE.sha256 || "Published with each release"}</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= Browser extension ======================= -->
  <section id="extension" class="dl-sec">
    <div class="wrap">
      <div class="extband">
        <div class="chromebar" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="ext-main">
          <img class="ext-logo" src="/img/chrome.svg" alt="Browser Extension" width="76" height="76" />
          <div class="ext-copy">
            <div class="eyebrow">Browser extension</div>
            <h2>Take over downloads right from your browser</h2>
            <p>The extension sends downloads in Chrome, Edge, Brave and other Chromium browsers to {SITE.name} and adds a Download button to videos. It talks only to {SITE.name} on your own PC, so install {SITE.name} first.</p>
            <div class="browsers">
              <span><img src="/img/chrome.svg" alt="Chrome" width="20" height="20" />Chrome</span>
              <span><img src="/img/edge.svg" alt="Edge" width="20" height="20" />Edge</span>
              <span><img src="/img/brave.svg" alt="Brave" width="20" height="20" />Brave</span>
              <span class="more-browsers">+ More</span>
            </div>
          </div>
        </div>
        {SITE.extensionUrl ? (
          SITE.extensionUrl.endsWith(".zip") ? (
            <a class="btn btn-chrome btn-lg" href={SITE.extensionUrl} download="boltgrab-extension.zip">
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={`<path d="M10 4h4v3a2 2 0 1 0 4 0V4h2v6h-3a2 2 0 1 0 0 4h3v6H4v-6h3a2 2 0 1 0 0-4H4V4z" ${s}/>`}></svg>
              Download extension (.zip)
            </a>
          ) : (
            <a class="btn btn-chrome btn-lg" href={SITE.extensionUrl} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={`<path d="M10 4h4v3a2 2 0 1 0 4 0V4h2v6h-3a2 2 0 1 0 0 4h3v6H4v-6h3a2 2 0 1 0 0-4H4V4z" ${s}/>`}></svg>
              Get the extension
            </a>
          )
        ) : (
          <span class="btn btn-chrome btn-lg" role="note" aria-disabled="true" style="opacity:.65;cursor:default">
            Coming soon to the Chrome Web Store
          </span>
        )}
      </div>

      {SITE.extensionUrl.endsWith(".zip") && (
        <div class="ext-guide">
          <div class="ext-guide-head">
            <h3>How to install the extension (4 quick steps)</h3>
            <p>Works in Chrome, Edge, Brave, and other Chromium browsers — takes about 30 seconds.</p>
          </div>
          <div class="ext-steps">
            <article class="ext-step">
              <div class="ext-step-top">
                <span class="ext-step-num">1</span>
                <h4>Download and unzip the file</h4>
              </div>
              <p>Click <b>Download extension (.zip)</b> above, then right-click <code>boltgrab-extension.zip</code> in Downloads and choose <b>Extract All...</b> into a folder.</p>
              <img class="ext-shot" src="/img/ext-step-1.svg" alt="Step 1: Right-click boltgrab-extension.zip and choose Extract All" width="640" height="380" loading="lazy" />
            </article>
            <article class="ext-step">
              <div class="ext-step-top">
                <span class="ext-step-num">2</span>
                <h4>Open Extensions &amp; enable Developer mode</h4>
              </div>
              <p>Paste <code>chrome://extensions</code> (or <code>edge://extensions</code> / <code>brave://extensions</code>) into your address bar, then switch on <b>Developer mode</b> in the top-right.</p>
              <img class="ext-shot" src="/img/ext-step-2.svg" alt="Step 2: Open chrome://extensions and turn on Developer mode" width="640" height="380" loading="lazy" />
            </article>
            <article class="ext-step">
              <div class="ext-step-top">
                <span class="ext-step-num">3</span>
                <h4>Click "Load unpacked" and pick the folder</h4>
              </div>
              <p>Click <b>Load unpacked</b> in the top-left, select the extracted <code>boltgrab-extension</code> folder (the one containing <code>manifest.json</code>), and click <b>Select Folder</b>.</p>
              <img class="ext-shot" src="/img/ext-step-3.svg" alt="Step 3: Click Load unpacked and select the extracted boltgrab-extension folder" width="640" height="380" loading="lazy" />
            </article>
            <article class="ext-step">
              <div class="ext-step-top">
                <span class="ext-step-num">4</span>
                <h4>Done! Pin BoltGrab to your toolbar</h4>
              </div>
              <p><b>BoltGrab Download Manager Integration</b> is now active. Keep the extracted folder on your PC (don't delete it) and pin the icon from your browser's puzzle menu.</p>
              <img class="ext-shot" src="/img/ext-step-4.svg" alt="Step 4: BoltGrab Download Manager Integration extension enabled in Chrome" width="640" height="380" loading="lazy" />
            </article>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ======================= Install steps ======================= -->
  <section class="dl-sec">
    <div class="wrap">
      <div class="sec-head center">
        <div class="eyebrow">Get started</div>
        <h2>Install in four steps</h2>
        <p>From download to your first accelerated file in a few minutes.</p>
      </div>
      <div class="steps4">
        {steps.map((st, n) => (
          <article class="tile white dlstep">
            <span class="stepno">{n + 1}</span>
            <div class="ico"><svg viewBox="0 0 24 24" set:html={st.i}></svg></div>
            <h3>{st.t}</h3>
            <p>{st.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================= Requirements ======================= -->
  <section class="dl-sec">
    <div class="wrap">
      <div class="sec-head center">
        <div class="eyebrow">Before you install</div>
        <h2>System requirements</h2>
      </div>
      <div class="reqs">
        {reqs.map((r) => (
          <article class="tile">
            <div class="ico"><svg viewBox="0 0 24 24" set:html={r.i}></svg></div>
            <h3>{r.t}</h3>
            <p>{r.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================= Verify + SmartScreen ======================= -->
  <section class="dl-sec">
    <div class="wrap">
      <div class="verify">
        <article class="tile dark">
          <div class="ico"><svg viewBox="0 0 24 24" set:html={`<path d="M12 3 4 6v6c0 4.5 3.2 7.8 8 9 4.8-1.2 8-4.5 8-9V6z" ${s}/><path d="m9 12 2 2 4-4" ${s}/>`}></svg></div>
          <h3>Verify your download</h3>
          <p>Compare the SHA-256 above with your file. In PowerShell run:</p>
          <pre class="cmd"><code>Get-FileHash .\BoltGrab-setup.exe</code></pre>
        </article>
        <article class="tile">
          <div class="ico"><svg viewBox="0 0 24 24" set:html={`<path d="M12 3 2.5 20h19z" ${s}/><path d="M12 10v4M12 17.5v.01" ${s}/>`}></svg></div>
          <h3>"Windows protected your PC"?</h3>
          <p>New apps are not yet widely seen by Windows SmartScreen, which can show this message even for safe software. Check the SHA-256 above, then choose <b>More info</b> and <b>Run anyway</b>.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ======================= Help ======================= -->
  <section class="dl-sec" style="padding-bottom:96px">
    <div class="wrap">
      <div class="helpband">
        <div>
          <h2>Need help installing?</h2>
          <p>Tell us your Windows version and what you saw, and we will get you going.</p>
        </div>
        <a class="btn btn-primary btn-lg" href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>
      </div>
    </div>
  </section>
</Base>
