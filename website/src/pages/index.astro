---
import Base from "../layouts/Base.astro";
import Demo from "../components/Demo.astro";
import PostCard from "../components/PostCard.astro";
import { SITE, buyHref } from "../config";
import { getPosts } from "../lib/blog";

const latest = (await getPosts()).slice(0, 3);
const site = Astro.site!.href.replace(/\/$/, "");

// One list drives both the visible FAQ and the structured data. `html` may contain links; `text` is the plain version.
const faqs = [
  { q: "Is there a free trial?", text: "No. BoltGrab is a paid app: one payment for a lifetime license, with no subscription. Every feature is included.", html: "No. BoltGrab is a paid app: one payment for a lifetime license, with no subscription. Every feature is included." },
  { q: "How do I get and use my license key?", text: "After payment you receive your license key. Install BoltGrab, open Help > Activate License and paste the key. It is checked on your PC, so it does not need the internet.", html: "After payment you receive your license key. Install BoltGrab, open <b>Help &gt; Activate License</b> and paste the key. It is checked on your PC, so it does not need the internet." },
  { q: "Which browsers does it work with?", text: "The extension is built for Chrome, Edge and Brave. You can also paste a link into BoltGrab directly, or copy a link and let BoltGrab offer to download it.", html: "The extension is built for Chrome, Edge and Brave. You can also paste a link into BoltGrab directly, or copy a link and let BoltGrab offer to download it." },
  { q: "Can it download videos from websites?", text: "Yes, from many video sites, with a quality menu. BoltGrab sets up the components it needs by itself the first time. Videos protected by DRM, such as paid streaming services, are not downloaded.", html: "Yes, from many video sites, with a quality menu. BoltGrab sets up the components it needs by itself the first time. Videos protected by DRM, such as paid streaming services, are not downloaded." },
  { q: "Does BoltGrab collect my data?", text: "No ads and no tracking. Your downloads, queues and settings stay on your PC. A few optional features contact other services when you use them, for example the VirusTotal lookup and the speed test. The privacy page lists every one.", html: 'No ads and no tracking. Your downloads, queues and settings stay on your PC. A few optional features contact other services when you use them, for example the VirusTotal lookup and the speed test. The <a href="/privacy/">privacy page</a> lists every one.' },
  { q: "Windows says it doesn't recognise the app. Is it safe?", text: "While an app is new, Windows SmartScreen can show a warning for software it has not seen often. You can check the installer's SHA-256 on the download page against the file you received before running it.", html: 'While an app is new, Windows SmartScreen can show a warning for software it has not seen often. You can check the installer\'s SHA-256 on the <a href="/download/">download page</a> against the file you received before running it.' },
  { q: "Does it work on Mac or Linux?", text: "Not yet. BoltGrab is for Windows 10 and 11 for now.", html: "Not yet. BoltGrab is for Windows 10 and 11 for now." },
];

const jsonLd = [
  { "@context": "https://schema.org", "@type": "Organization", name: SITE.name, url: site + "/", logo: site + "/img/icon-256.png", email: SITE.supportEmail },
  { "@context": "https://schema.org", "@type": "WebSite", name: SITE.name, url: site + "/", inLanguage: SITE.language },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: SITE.name,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Windows 10, Windows 11",
    softwareVersion: SITE.version,
    description: SITE.description,
    image: site + SITE.ogImage,
    url: site + "/",
    offers: { "@type": "Offer", price: SITE.priceUsd, priceCurrency: "USD", availability: "https://schema.org/InStock", url: site + "/pricing/" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.text } })),
  },
];

const stroke = 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
---
<Base
  fullTitle
  title="BoltGrab – Fast, reliable download manager for Windows"
  description="BoltGrab is a fast Windows download manager. It splits files across many connections, resumes after any break and takes over from Chrome, Edge and Brave."
  current="home"
  jsonLd={jsonLd}
>
  <link slot="head" rel="stylesheet" href={"/css/home.css?v=" + Date.now()} />

  <!-- ======================= Hero ======================= -->
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow"><i></i>Download manager for Windows</span>
      <h1>Downloads that don't give up.</h1>
      <p class="lead">Split every file across many connections, carry on after any interruption, and take over downloads from your browser. Fast when the network is good, patient when it is not.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/#pricing">Get BoltGrab Pro · $19.99</a>
        <a class="btn btn-ghost" href="/#demo">Try the live demo</a>
      </div>
      <p class="meta">One-time payment, lifetime license · No ads · No tracking</p>

      <Demo />

      <div class="stats">
        <div class="stat dark"><b>A download manager built for the moments a connection fails.</b><span>Windows 10 &amp; 11</span></div>
        <div class="stat"><strong>32</strong><span>Connections per file</span></div>
        <div class="stat"><strong>8×</strong><span>Faster when a connection goes silent</span></div>
        <div class="stat"><strong>$19.99</strong><span>Once. No subscription</span></div>
      </div>
      <div class="worksw" aria-label="Works with">
        <span>Chrome</span><span>Edge</span><span>Brave</span><span>HTTP &amp; HTTPS</span><span>FTP · SFTP</span><span>Torrents</span><span>HLS · DASH</span>
      </div>
    </div>
  </section>

  <!-- ======================= Statement ======================= -->
  <section class="statement">
    <div class="wrap">
      <p>Downloads rarely fail in one dramatic moment. A connection stalls, a link expires, the Wi-Fi blinks. <em>BoltGrab keeps every part moving, remembers every byte and checks the file before you open it.</em></p>
    </div>
  </section>

  <!-- ======================= Features (bento) ======================= -->
  <section id="features" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">The download engine</div>
        <h2>Everything behind every download</h2>
        <p>Watch live work, keep the speed where you want it and know what you are opening, without babysitting a progress bar.</p>
      </div>
      <div class="bento">
        <article class="tile white tall">
          <div class="ico"><svg viewBox="0 0 24 24" set:html={`<path d="M13 2 3 14h9l-1 8 10-12h-9z" ${stroke}/>`}></svg></div>
          <h3>Many connections, smartly</h3>
          <p>Files are split into parts and fetched in parallel, up to 32 connections. When one part is slow, another connection takes over its remaining work.</p>
          <div class="mini" style="margin-top:auto">
            <div class="row"><span class="pip"></span><span>connection 01</span><span class="g r">24.1 MB/s</span></div>
            <div class="row"><span class="pip"></span><span>connection 02</span><span class="g r">22.8 MB/s</span></div>
            <div class="row"><span class="pip l"></span><span>connection 03</span><span class="l r">taking over part 7</span></div>
          </div>
        </article>

        <article class="tile lime">
          <svg class="stack" viewBox="0 0 236 278" aria-hidden="true" focusable="false"><polygon points="118,154 236,213 118,272 0,213" fill="#15200a" opacity=".14"/><g><polygon points="22,180 118,228 118,256 22,208" fill="#1b1b20"/><polygon points="118,228 214,180 214,208 118,256" fill="#0e0e11"/><polygon points="118,132 214,180 118,228 22,180" fill="#33333a"/><text transform="matrix(1 -.5 0 1 130 241)" font-family="Outfit, sans-serif" font-size="15" font-weight="700" letter-spacing=".04em" fill="#ffffff">Queue</text></g><g><polygon points="22,140 118,188 118,216 22,168" fill="#e7eed0"/><polygon points="118,188 214,140 214,168 118,216" fill="#d3dcb4"/><polygon points="118,92 214,140 118,188 22,140" fill="#ffffff"/><text transform="matrix(1 -.5 0 1 130 201)" font-family="Outfit, sans-serif" font-size="15" font-weight="700" letter-spacing=".04em" fill="#15200a">Schedule</text></g><g><polygon points="22,100 118,148 118,176 22,128" fill="#438a2a"/><polygon points="118,148 214,100 214,128 118,176" fill="#2f6a1b"/><polygon points="118,52 214,100 118,148 22,100" fill="#5fae3d"/><text transform="matrix(1 -.5 0 1 130 161)" font-family="Outfit, sans-serif" font-size="15" font-weight="700" letter-spacing=".04em" fill="#ffffff">Turbo</text></g><g><polygon points="22,60 118,108 118,136 22,88" fill="#d2e68f"/><polygon points="118,108 214,60 214,88 118,136" fill="#b9d26c"/><polygon points="118,12 214,60 118,108 22,60" fill="#eef6c4"/><text transform="matrix(1 -.5 0 1 130 121)" font-family="Outfit, sans-serif" font-size="15" font-weight="700" letter-spacing=".04em" fill="#15200a">Resume</text></g><g transform="matrix(1 .5 -1 .5 118 12)" fill="#15200a"><rect x="42" y="22" width="12" height="28"/><polygon points="28,48 68,48 48,70"/><rect x="30" y="74" width="36" height="6"/></g></svg>
          <span class="badge"><svg viewBox="0 0 24 24" set:html={`<circle cx="12" cy="12" r="9" ${stroke}/><path d="m8 12 3 3 5-6" ${stroke}/>`}></svg></span>
          <h3>Resumes after<br />anything.</h3>
          <p>Closed the app, lost your Wi-Fi, or the PC crashed? Downloads wait for the network and continue from the last saved byte.</p>
          <small>Measured: 36.6 s with a 30-second outage, against 70.3 s for one connection.</small>
        </article>

        <article class="tile">
          <div class="ico"><svg viewBox="0 0 24 24" set:html={`<circle cx="12" cy="12" r="9" ${stroke}/><path d="M12 7v5l3 2" ${stroke}/>`}></svg></div>
          <h3>Bandwidth control</h3>
          <p>Limit speed by time of day and day of week, switch on slow mode while you work, and pause on metered connections.</p>
        </article>

        <article class="tile dark">
          <div class="ico"><svg viewBox="0 0 24 24" set:html={`<path d="M12 3 4 6v6c0 5 3.4 8 8 9 4.6-1 8-4 8-9V6z" ${stroke}/><path d="m9 12 2 2 4-4" ${stroke}/>`}></svg></div>
          <h3>Safety checks</h3>
          <p>Warnings for programs and disguised files like <em>invoice.pdf.exe</em>, plus an optional VirusTotal lookup that sends only the file's fingerprint.</p>
        </article>

        <article class="tile white wide">
          <div>
            <h3>Videos with a quality menu</h3>
            <p>A Download button appears on videos, with a list of qualities and a recommended choice. Streams (HLS and DASH) are joined for you, and the tools needed are installed automatically.</p>
          </div>
          <div class="mini light">
            <header><span>Video · 3 qualities</span><span>mp4</span></header>
            <div class="row"><span class="pip"></span><span class="m">2160p</span><span class="m r">24 GB</span></div>
            <div class="row"><span class="pip l"></span><span>1080p</span><span class="l r">recommended</span></div>
            <div class="row"><span class="pip"></span><span class="m">720p</span><span class="m r">1.8 GB</span></div>
          </div>
        </article>

        <article class="tile">
          <div class="ico"><svg viewBox="0 0 24 24" set:html={`<rect x="3" y="4" width="18" height="6" rx="2" ${stroke}/><rect x="3" y="14" width="18" height="6" rx="2" ${stroke}/><path d="M7 7h.01M7 17h.01" ${stroke}/>`}></svg></div>
          <h3>Queues and scheduling</h3>
          <p>Line downloads up, start them at night, then sleep, shut down or run a program when they finish.</p>
        </article>

        <article class="tile">
          <div class="ico"><svg viewBox="0 0 24 24" set:html={`<circle cx="12" cy="12" r="9" ${stroke}/><path d="M3 12h18" ${stroke}/><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z" ${stroke}/>`}></svg></div>
          <h3>Browser extension</h3>
          <p>Works with Chrome, Edge and Brave. Click a link and BoltGrab takes over, with your login session passed along.</p>
        </article>

        <article class="tile">
          <div class="ico"><svg viewBox="0 0 24 24" set:html={`<path d="M12 3v12" ${stroke}/><path d="m7 10 5 5 5-5" ${stroke}/><path d="M4 21h16" ${stroke}/>`}></svg></div>
          <h3>Bring your downloads along</h3>
          <p>Import from IDM, JDownloader, Free Download Manager or your browser's history. Back up everything in one file.</p>
        </article>

        <article class="tile">
          <div class="ico"><svg viewBox="0 0 24 24" set:html={`<path d="M6 3v6a6 6 0 0 0 12 0V3" ${stroke}/><path d="M6 7h4M14 7h4" ${stroke}/>`}></svg></div>
          <h3>Torrents, FTP and more</h3>
          <p>Magnet links, FTP, FTPS and SFTP, batch patterns like <em>img_[001-100].jpg</em>, and a site grabber for whole folders.</p>
        </article>
      </div>
      <p class="more"><a class="btn btn-ghost" href="/features/">See every feature in detail →</a></p>
    </div>
  </section>

  <!-- ======================= How it works ======================= -->
  <section id="how" style="padding-top:40px">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">From click to file</div>
        <h2>Install once.<br />Download like always.</h2>
      </div>

      <div class="rowsec">
        <div class="t">
          <h3>Add a link, or a hundred</h3>
          <p>Paste a link, click one in your browser, or type a pattern and let BoltGrab build the whole list for you.</p>
          <ul class="ticks">
            <li>One click in Chrome, Edge or Brave. The extension connects by itself</li>
            <li>Copy a link anywhere and BoltGrab offers to download it</li>
            <li>Passwords are kept in the Windows Credential Manager</li>
          </ul>
        </div>
        <div class="codecard">
          <header><span>Batch download</span><span>Pattern</span></header>
<pre><span class="c"># one pattern, one hundred files</span>
<span class="k">https://example.com/photos/</span><span class="n">img_[001-100].jpg</span>

<span class="c">found</span>     <span class="s">100 files</span>
<span class="c">saves to</span>  <span class="s">Downloads\Images</span>
<span class="c">parts</span>     <span class="s">up to 32 connections each</span>
<span class="c">after</span>     <span class="s">sleep when finished</span></pre>
        </div>
      </div>

      <div class="rowsec">
        <div class="t">
          <h3>Know what you are opening</h3>
          <p>When a download finishes, BoltGrab checks it and asks before opening anything that looks risky.</p>
        </div>
        <ul class="ticks" style="margin:0">
          <li>Warns about programs and disguised double extensions</li>
          <li>Clear message when a site sends a login page instead of your file</li>
          <li>Optional VirusTotal lookup: only the fingerprint is sent, never the file</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ======================= Speed lab ======================= -->
  <section id="speed" style="padding-top:30px">
    <div class="wrap">
      <div class="sec-head center">
        <div class="eyebrow">Speed, measured</div>
        <h2>Where BoltGrab pulls ahead:<br />bad networks</h2>
        <p>On a healthy connection a good downloader is already fast. The difference shows when connections stall, slow down or drop. Pick a scenario and watch the race.</p>
      </div>
      <div class="lab" id="lab">
        <div class="lab-tabs" role="group" aria-label="Scenario">
          <button type="button" data-scen="slow" aria-pressed="true">One connection is slow</button>
          <button type="button" data-scen="silent" aria-pressed="false">A connection goes silent</button>
          <button type="button" data-scen="outage" aria-pressed="false">30-second outage</button>
          <button type="button" class="btn btn-lime btn-sm lab-run" data-lab-run>Run again</button>
        </div>
        <p class="lab-desc" data-lab-desc>One connection is slow. A plain 8-part downloader waits for its slowest part to finish; BoltGrab hands that part's remaining work to idle connections.</p>
        <div class="lab-bars">
          <div class="lab-bar"><span>One connection</span><div class="tr"><i></i></div><span class="tm">14.4 s</span></div>
          <div class="lab-bar"><span>8 fixed parts</span><div class="tr"><i></i></div><span class="tm">16.5 s</span></div>
          <div class="lab-bar us"><span>BoltGrab</span><div class="tr"><i></i></div><span class="tm">5.5 s</span></div>
        </div>
        <div class="lab-foot"><span data-lab-result>Replay of the measured run, sped up.</span><span>Time to download the same file · lower is better</span></div>
      </div>
      <p class="fine" style="max-width:900px;margin-inline:auto">This animation replays real measurements, sped up. They come from a local test server that misbehaves in a repeatable way, with every file checked against its SHA-256. "8 fixed parts" is a plain 8-connection downloader, not any particular product. On a healthy network the three are close, and in a short 5-second outage BoltGrab was slightly slower than the plain downloader. Real-world results depend on your connection.</p>
    </div>
  </section>

  <!-- ======================= Pricing ======================= -->
  <section id="pricing">
    <div class="wrap">
      <div class="sec-head center">
        <div class="eyebrow">Pricing</div>
        <h2>Pay once. Use it for good.</h2>
        <p>One license, every feature, no subscription.</p>
      </div>
      <div class="pricecard">
        <div class="l">
          <small>BoltGrab Pro · lifetime</small>
          <div class="amt">$19.99</div>
          <p>A one-time payment, no renewals.</p>
        </div>
        <div class="r">
          <h3>Everything included</h3>
          <ul class="ticks" style="margin:0">
            <li>Every feature, including Turbo Mode and video downloads</li>
            <li>A license key after payment; it activates offline</li>
            <li>One payment, no subscription and no renewals</li>
            <li>Windows 10 and 11</li>
          </ul>
          <a class="btn btn-primary" href={buyHref()}>Buy BoltGrab Pro</a>
          <p class="fine" style="margin-top:14px">Already bought it? <a href="/download/" style="text-decoration:underline;text-underline-offset:3px">Download the installer</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= FAQ ======================= -->
  <section id="faq">
    <div class="wrap">
      <div class="sec-head center">
        <div class="eyebrow">Practical details</div>
        <h2>What you need to know</h2>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p set:html={f.html} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================= From the blog ======================= -->
  {latest.length > 0 && (
    <section style="padding-top:20px">
      <div class="wrap">
        <div class="sec-head center">
          <div class="eyebrow">From the blog</div>
          <h2>Guides for faster, safer downloads</h2>
        </div>
        <div class="bgrid">
          {latest.map((p) => <PostCard post={p} />)}
        </div>
        <p class="more"><a class="btn btn-ghost" href="/blog/">All articles →</a></p>
      </div>
    </section>
  )}

  <!-- ======================= CTA ======================= -->
  <section style="padding-top:30px">
    <div class="wrap">
      <div class="band">
        <span class="spark" style="left:12%;top:22%"><svg viewBox="0 0 24 24" set:html={`<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" />`}></svg></span>
        <span class="spark" style="right:11%;top:30%"><svg viewBox="0 0 24 24" set:html={`<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" />`}></svg></span>
        <span class="spark" style="left:21%;bottom:18%"><svg viewBox="0 0 24 24" set:html={`<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" />`}></svg></span>
        <span class="spark" style="right:14%;bottom:12%"><svg viewBox="0 0 24 24" set:html={`<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" />`}></svg></span>
        <div class="eyebrow">One payment · every feature</div>
        <h2>Give your downloads a better engine.</h2>
        <p>Install it, add the extension, and the next big file is already on its way.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/#pricing">Get BoltGrab Pro · $19.99</a>
          <a class="btn btn-ghost" href="/#demo">Try the live demo</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline src="/js/lab.js" defer></script>
</Base>
