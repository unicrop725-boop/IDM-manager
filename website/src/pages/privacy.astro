---
import Base from "../layouts/Base.astro";
import { SITE, buyHref } from "../config";
import { getPosts, formatDate, readingMinutes } from "../lib/blog";

const site = Astro.site!.href.replace(/\/$/, "");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site + "/" },
      { "@type": "ListItem", position: 2, name: 'Privacy', item: site + '/privacy/' },
    ],
  },
];
---
<Base
  title='Privacy: what FlowGet stores and sends'
  description='What FlowGet keeps on your PC and the few optional features that contact other services. No ads and no tracking.'
  current=''
  jsonLd={jsonLd}
>

  <div class="wrap">
    <div class="page-head">
      <h1>Privacy</h1>
      <p>FlowGet has no ads and no tracking. This page lists what it keeps and every optional feature that contacts another service.</p>
    </div>

    <div class="prose">
      <p class="fine">Draft for review before launch: please have it checked against your final product, payment provider and local law.</p>

      <h2>What stays on your PC</h2>
      <ul>
        <li>Your download list, queues, categories and settings are stored in a file on your PC.</li>
        <li>Passwords for downloads that need a login are kept in the Windows Credential Manager, not in that file.</li>
        <li>The browser extension sends links, file names and the cookies needed for a download only to FlowGet on your own PC (the address 127.0.0.1). Cookies are not stored on disk by the extension.</li>
        <li>Your license is checked on your PC against a digital signature. It does not need the internet.</li>
        <li>FlowGet does not send usage statistics or crash reports.</li>
      </ul>

      <h2>When FlowGet contacts other services</h2>
      <p>Only for the things you ask it to do, or the optional features below.</p>
      <ul>
        <li><b>The downloads themselves.</b> FlowGet connects to the websites you download from, just like a browser would.</li>
        <li><b>VirusTotal check (off by default).</b> If you add your own API key, FlowGet sends the SHA-256 fingerprint of a finished file to VirusTotal. The file is never uploaded.</li>
        <li><b>Video tools.</b> The first time a video needs them, FlowGet downloads yt-dlp from GitHub and ffmpeg from gyan.dev, and checks each against the publisher's checksum. yt-dlp is refreshed about weekly unless you switch that off.</li>
        <li><b>Speed test.</b> Only when you open it: it measures against Cloudflare's speed servers.</li>
        <li><b>Trusted Sites.</b> The page shows each listed site's own icon, which your PC loads from that site when you open the page.</li>
      </ul>

      <h2>This website</h2>
      <p>This website sets no cookies and loads nothing from other companies. Our hosting provider may keep standard server logs for security and reliability.</p>

      <h2>Contact</h2>
      <p>Questions about privacy: <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a></p>
    </div>
  </div>

</Base>
