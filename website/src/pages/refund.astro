---
import Base from "../layouts/Base.astro";
import { SITE } from "../config";

const site = Astro.site!.href.replace(/\/$/, "");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site + "/" },
      { "@type": "ListItem", position: 2, name: "Refund Policy", item: site + "/refund/" },
    ],
  },
];
---
<Base
  title={`Refund Policy — ${SITE.name}`}
  description={`Refund policy for ${SITE.name} Pro one-time licenses, including eligibility window and how to request a refund.`}
  current=""
  jsonLd={jsonLd}
>

  <div class="wrap">
    <div class="page-head">
      <h1>Refund Policy</h1>
      <p>Clear, fair refund terms for {SITE.name} Pro one-time license purchases.</p>
    </div>

    <div class="prose">
      <p class="fine">Last updated: November 2026</p>

      <h2>14-day money-back guarantee</h2>
      <p>If {SITE.name} Pro does not work as expected on your Windows 10 or 11 PC, or if you purchased by mistake, you can request a full refund within <b>14 days</b> of your purchase date.</p>

      <h2>When refunds are approved</h2>
      <ul>
        <li>Technical issues on your Windows PC that our support team cannot resolve within a reasonable time.</li>
        <li>Accidental duplicate purchases or billing errors.</li>
        <li>Requests submitted within 14 calendar days of the original transaction.</li>
      </ul>

      <h2>When refunds may be declined</h2>
      <ul>
        <li>Requests made more than 14 days after purchase.</li>
        <li>Abuse of the refund policy (such as repeated purchases and refund requests, or sharing a license key publicly).</li>
      </ul>

      <h2>How to request a refund</h2>
      <ol>
        <li>Email <a href={`mailto:${SITE.supportEmail}?subject=${encodeURIComponent("Refund Request - BoltGrab Pro")}`}>{SITE.supportEmail}</a> from the email address used at checkout.</li>
        <li>Include your <b>order ID</b> (from your Dodo Payments receipt) and a short note about what went wrong.</li>
        <li>Approved refunds are issued back to your original payment method through Dodo Payments, typically within <b>5–10 business days</b> depending on your bank or card issuer.</li>
      </ol>
      <p>Once a refund is issued, the corresponding license key is deactivated.</p>
    </div>
  </div>

</Base>
