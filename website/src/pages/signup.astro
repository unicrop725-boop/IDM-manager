---
import Base from "../layouts/Base.astro";
import AuthShell from "../components/AuthShell.astro";
import AuthForms from "../components/AuthForms.astro";
---
<Base title="Create account" description="Create your FlowGet account." noindex bare bodyClass="authx">
  <link slot="head" rel="stylesheet" href={"/css/auth.css?v=" + Date.now()} />
  <AuthShell hint="Already have an account?" linkText="Sign in" linkHref="/signin/">
    <AuthForms mode="signup" />
  </AuthShell>
  <script is:inline src="/js/auth.js" defer></script>
</Base>
